# Aurora — environment configuration
# Single source of truth per DEPLOYMENT.md §3. Copy to .env (gitignored) and fill in secrets.
# Loaded once via app/core/config.py (pydantic-settings), imported by both app/ and worker/ —
# the process refuses to boot with an invalid/missing required var rather than failing later.

# --- Environment ---
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO

# --- Postgres (system of record, DATA_MODEL.md §1) ---
DATABASE_URL=postgresql+asyncpg://aurora:aurora@localhost:5432/aurora

# --- Redis (sessions, rate limiting, Celery broker, pub/sub, DATA_MODEL.md §2) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=4
CELERY_VISIBILITY_TIMEOUT_SECONDS=300

# --- Auth (API_SPEC.md Auth) ---
JWT_SECRET=change-me-in-real-env  # HS256 signing secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15

# --- Model provider (ARCHITECTURE.md §4) ---
MODEL_PROVIDER=ollama              # ollama | vllm | mock
MODEL_PROVIDER_URL=http://host.docker.internal:11434
DEFAULT_MODEL=llama3.2:3b

# --- Rate limiting (ERROR_HANDLING.md §1) ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Timeouts (ERROR_HANDLING.md §2) ---
QUEUE_WAIT_TIMEOUT_SECONDS=60
INFERENCE_TIMEOUT_SECONDS=30

# --- Retry policy (ERROR_HANDLING.md §3) ---
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=0.5     # 0.5s -> 1s -> 2s

# --- Circuit breaker (ERROR_HANDLING.md §4, Phase 2) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=30
CIRCUIT_BREAKER_COOLDOWN_SECONDS=20

# --- Backpressure (ERROR_HANDLING.md §5, Phase 2) ---
MAX_QUEUE_DEPTH=200

# --- Message limits (API_SPEC.md) ---
MAX_MESSAGE_LENGTH=4000
