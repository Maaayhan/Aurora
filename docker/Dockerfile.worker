FROM python:3.12-slim AS base

WORKDIR /srv

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock* README.md ./
RUN uv sync --no-dev --no-install-project

COPY app/ ./app/
COPY worker/ ./worker/
COPY providers/ ./providers/
COPY shared/ ./shared/

RUN uv sync --no-dev

# --no-sync: see Dockerfile.api — avoids re-syncing (incl. dev deps) on every container start.
CMD ["uv", "run", "--no-sync", "celery", "-A", "worker.celery_app", "worker", "--loglevel=info"]
